;Tecnigrafo 0.8.1 - ATTSYNC (prima e dopo)
;disegno nuovo dal modello acadlt-Tecnigrafo.dwt
;--- variabili del profilo e correnti
CMDECHO
1
MEASUREMENT
1
INSUNITS
4
OSMODE
0
OSNAPCOORD
1
ORTHOMODE
0
SNAPMODE
0
DYNMODE
0
MIRRTEXT
0
ATTREQ
1
ATTDIA
0
ATTMODE
1
TEXTSIZE
2.5
CECOLOR
BYLAYER
CLAYER
0
TEXTSTYLE
Standard
;--- due blocchi uguali: ATTSYNC aggiorna tutti gli inserimenti del blocco scelto,
;    quindi il 'prima' resta in SINCRO_B, non sincronizzato
;SINCRO_A, prima definizione: rettangolo, PRIMO, SECONDO, TERZO
_RECTANG
0,0
40,20
AFLAGS
0
_-ATTDEF

PRIMO
Primo
P0
2,15
2.5
0
AFLAGS
0
_-ATTDEF

SECONDO
Secondo
S0
2,10
2.5
0
AFLAGS
0
_-ATTDEF

TERZO
Terzo
T0
2,5
2.5
0
AFLAGS
0
_-BLOCK
SINCRO_A
0,0
_ALL

;SINCRO_B, prima definizione: rettangolo, PRIMO, SECONDO, TERZO
_RECTANG
0,0
40,20
