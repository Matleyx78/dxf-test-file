0
_-BLOCK
SINCRO_B
0,0
_ALL

;--- inserimenti con ATTREQ 1 (domande in ordine inverso: TERZO, SECONDO, PRIMO)
_-INSERT
SINCRO_A
0,-40
1

0
A1-3
A1-2
A1-1
_-INSERT
SINCRO_A
60,-40
1

0
A2-3
A2-2
A2-1
_-INSERT
SINCRO_B
120,-40
1

0
B-3
B-2
B-1
;--- le finestre di selezione vogliono gli oggetti a schermo
_ZOOM
_W
-10,-60
180,70
